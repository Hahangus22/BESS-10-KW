// Definisikan Palet Warna RGB565 Premium - Tema Terang (Light Mode)
#define COLOR_BG        0xFFFF  // Background Putih Bersih
#define COLOR_CARD      0xF7F9  // Background Kartu (Abu-abu sangat muda/bersih)
#define COLOR_BORDER    0xCFDF  // Garis tepi kartu (Abu-abu pastel)
#define COLOR_CIRCUIT   0xD69A  // Jalur sirkuit redup (Abu-abu muda)
#define COLOR_TEXT      0x2104  // Teks utama Charcoal nyaman di mata
#define COLOR_TEXT_DIM  0x7BEF  // Teks redup (Medium Grey)
#define COLOR_CYAN      0x03ED  // Sian Terang Kontras
#define COLOR_CYAN_BG   0xE7FD  // Sian redup/pastel background
#define COLOR_ORANGE    0xE4A0  // Oranye Terang Kontras
#define COLOR_ORANGE_BG 0xFEDF  // Oranye redup/pastel background
#define COLOR_BLUE      0x027F  // Biru Terang untuk SOC
#define COLOR_BLUE_BG   0xD7FF  // Biru redup/pastel background
#define COLOR_PURPLE    0x8019  // Ungu Terang Kontras
#define COLOR_PURPLE_BG 0xF51F  // Ungu redup/pastel background
#define COLOR_GREEN     0x0480  // Hijau Daun Terang Kontras
#define COLOR_WHITE     0xFFFF

// Simulasi Data BESS
float soc = 96.0;
float soh = 98.5;
float voltage = 52.4;
float current = 15.4;
float power = 0.80;
float temp = 28.5;

// Data Telemetry Detail Cells (16 Cell Voltase & 4 Sensor Suhu)
float cells[16];
float cell_temps[4];

unsigned long lastUpdate = 0;
const unsigned long updateInterval = 1000; // Update otomatis tiap 1 detik

// Helper Fungsi untuk Menggambar Arc yang Halus & Tebal
void drawArc(int x, int y, int r_in, int r_out, int start_angle, int end_angle, uint16_t color) {
  if (start_angle > end_angle) {
    int temp = start_angle;
    start_angle = end_angle;
    end_angle = temp;
  }
  for (int a = start_angle; a < end_angle; a += 3) {
    float rad1 = (a - 90) * 0.0174532925;
    float rad2 = (min(a + 3, end_angle) - 90) * 0.0174532925;
    
    float cos1 = cos(rad1);
    float sin1 = sin(rad1);
    float cos2 = cos(rad2);
    float sin2 = sin(rad2);
    
    int x1_in = x + r_in * cos1;
    int y1_in = y + r_in * sin1;
    int x1_out = x + r_out * cos1;
    int y1_out = y + r_out * sin1;
    
    int x2_in = x + r_in * cos2;
    int y2_in = y + r_in * sin2;
    int x2_out = x + r_out * cos2;
    int y2_out = y + r_out * sin2;
    
    tft.fillTriangle(x1_in, y1_in, x1_out, y1_out, x2_in, y2_in, color);
    tft.fillTriangle(x1_out, y1_out, x2_out, y2_out, x2_in, y2_in, color);
  }
}

// Mengacak data secara realistis
void randomizeData() {
  soc += random(-3, 2) * 0.1;
  if (soc > 100.0) soc = 100.0;
  if (soc < 10.0) soc = 96.0;
  
  soh += random(-5, 4) * 0.1;
  if (soh > 100.0) soh = 100.0;
  if (soh < 85.0) soh = 98.5;
  
  voltage += random(-8, 9) * 0.1;
  if (voltage > 55.0) voltage = 55.0;
  if (voltage < 48.0) voltage = 48.0;
  
  current += random(-15, 16) * 0.2;
  if (current > 45.0) current = 45.0;
  if (current < 0.0) current = 0.0;
  
  power = (voltage * current) / 1000.0;
  
  temp += random(-4, 5) * 0.2;
  if (temp > 38.0) temp = 38.0;
  if (temp < 25.0) temp = 25.0;

  for (int i = 0; i < 16; i++) {
    cells[i] += random(-12, 13) * 0.001;
    if (cells[i] > 3.699) cells[i] = 3.699;
    if (cells[i] < 3.499) cells[i] = 3.499;
  }
  for (int i = 0; i < 4; i++) {
    cell_temps[i] += random(-4, 5) * 0.1;
    if (cell_temps[i] > 45.0) cell_temps[i] = 45.0;
    if (cell_temps[i] < 25.0) cell_temps[i] = 25.0;
  }
}

// Gambar Aksen Dekorasi Jalur Sirkuit Elektronik (Disesuaikan dengan koordinat baru)
void drawCircuitLines() {
  // Jalur Kiri Atas ke Tengah (Tegangan ke SOC)
  tft.drawLine(143, 115, 180, 115, COLOR_CIRCUIT);
  tft.drawLine(180, 115, 210, 145, COLOR_CIRCUIT);
  tft.fillCircle(180, 115, 3, COLOR_CIRCUIT);
  
  // Jalur Kanan Atas ke Tengah (Arus ke SOC)
  tft.drawLine(337, 115, 300, 115, COLOR_CIRCUIT);
  tft.drawLine(300, 115, 270, 145, COLOR_CIRCUIT);
  tft.fillCircle(300, 115, 3, COLOR_CIRCUIT);
  
  // Jalur Kiri Bawah ke Tengah (Suhu ke SOC)
  tft.drawLine(143, 255, 180, 255, COLOR_CIRCUIT);
  tft.drawLine(180, 255, 210, 225, COLOR_CIRCUIT);
  tft.fillCircle(180, 255, 3, COLOR_CIRCUIT);
  
  // Jalur Kanan Bawah ke Tengah (Daya ke SOC)
  tft.drawLine(337, 255, 300, 255, COLOR_CIRCUIT);
  tft.drawLine(300, 255, 270, 225, COLOR_CIRCUIT);
}

void updateCircuitAnimation() {
  // 1. Hapus dot lama dengan menggambar lingkaran putih (COLOR_BG) di posisi sebelumnya
  if (prev_x1 > 0) {
    tft.fillCircle(prev_x1, prev_y1, 4, COLOR_BG);
    tft.fillCircle(prev_x2, prev_y2, 4, COLOR_BG);
    tft.fillCircle(prev_x3, prev_y3, 4, COLOR_BG);
    tft.fillCircle(prev_x4, prev_y4, 4, COLOR_BG);
  }

  // 2. Gambar ulang garis sirkuit abu-abu untuk memulihkan piksel garis yang terhapus
  drawCircuitLines();
  
  // 3. Hitung koordinat dot berjalan (Langkah 0 sampai 9)
  // Kiri Atas (Tegangan -> SOC)
  int x1 = 0, y1 = 0;
  if (animStep < 5) {
    x1 = 143 + animStep * 7;
    y1 = 115;
  } else {
    int ds = animStep - 5;
    x1 = 180 + ds * 6;
    y1 = 115 + ds * 6;
  }
  
  // Kanan Atas (Arus -> SOC)
  int x2 = 0, y2 = 0;
  if (animStep < 5) {
    x2 = 337 - animStep * 7;
    y2 = 115;
  } else {
    int ds = animStep - 5;
    x2 = 300 - ds * 6;
    y2 = 115 + ds * 6;
  }
  
  // Kiri Bawah (Suhu -> SOC)
  int x3 = 0, y3 = 0;
  if (animStep < 5) {
    x3 = 143 + animStep * 7;
    y3 = 255;
  } else {
    int ds = animStep - 5;
    x3 = 180 + ds * 6;
    y3 = 255 - ds * 6;
  }
  
  // Kanan Bawah (Daya -> SOC)
  int x4 = 0, y4 = 0;
  if (animStep < 5) {
    x4 = 337 - animStep * 7;
    y4 = 255;
  } else {
    int ds = animStep - 5;
    x4 = 300 - ds * 6;
    y4 = 255 - ds * 6;
  }
  
  // Gambar dot berwarna sesuai tema gauge masing-masing
  tft.fillCircle(x1, y1, 4, COLOR_CYAN);
  tft.fillCircle(x2, y2, 4, COLOR_ORANGE);
  tft.fillCircle(x3, y3, 4, COLOR_CYAN);
  tft.fillCircle(x4, y4, 4, COLOR_PURPLE);
  
  // Simpan koordinat saat ini untuk dihapus di frame berikutnya
  prev_x1 = x1; prev_y1 = y1;
  prev_x2 = x2; prev_y2 = y2;
  prev_x3 = x3; prev_y3 = y3;
  prev_x4 = x4; prev_y4 = y4;

  // Maju ke step berikutnya (0 s/d 9)
  animStep = (animStep + 1) % 10;
}

void logDataToSD() {
  if (!sdCardReady) return;
  
  File logFile = SD.open("/datalog1.csv", FILE_APPEND);
  if (logFile) {
    logFile.print(millis());
    logFile.print(",");
    logFile.print(voltage, 1);
    logFile.print(",");
    logFile.print(current, 1);
    logFile.print(",");
    logFile.print((int)soc);
    logFile.print(",");
    logFile.print(soh, 1);
    logFile.print(",");
    logFile.print((int)temp);
    logFile.print(",");
    logFile.println(power, 2);
    logFile.close();
    Serial.println("Data telemetry berhasil disimpan ke SD Card.");
  } else {
    Serial.println("Gagal membuka datalog1.csv untuk menulis data.");
  }
}

